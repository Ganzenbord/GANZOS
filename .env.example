# Ganz — instellingen.
# Kopieer dit bestand naar backend/.env en vul je eigen waarden in.
# Dit bestand mag in de repository staan; backend/.env nooit.

# development, test of production
GANZ_ENVIRONMENT=development

# Database. Voor PostgreSQL:
GANZ_DATABASE_URL=postgresql+asyncpg://ganz:ganz@localhost:5432/ganz

# Ondertekent de inlogtokens. Maak er een met:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GANZ_SECRET_KEY=

# Versleutelt de provider-tokens in de database. Maak er een met:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Let op: wissel je deze sleutel, dan moet je alle koppelingen opnieuw maken.
GANZ_ENCRYPTION_KEY=

# Hoe lang een sessie geldig is, en hoe kort een tweede bevestiging meegaat.
# Kort, want een inlogtoken staat nergens en is niet in te trekken. Wat je ingelogd houdt is
# het vernieuwingstoken; dat staat wél in de database en kan per apparaat worden ingetrokken.
GANZ_ACCESS_TOKEN_MINUTES=15
# Hoe lang een apparaat ongebruikt mag liggen voor je opnieuw moet inloggen.
GANZ_REFRESH_TOKEN_DAYS=60
GANZ_CONFIRMATION_TOKEN_MINUTES=5

# Na zoveel mispogingen binnen zoveel minuten gaat het slot erop bij het bevestigen.
# Dit is wat een pincode van vier cijfers tegen doorproberen beschermt.
GANZ_CONFIRMATION_MAX_FAILURES=5
GANZ_CONFIRMATION_LOCKOUT_MINUTES=15

# Waar de frontend vandaan mag komen (kommagescheiden).
GANZ_CORS_ORIGINS=http://localhost:5173

# YouTube. Client-ID en secret komen uit een eigen Google Cloud-project; zie docs/youtube.md.
# Het adres hieronder moet lettergelijk ook in de Google-console staan.
GANZ_YOUTUBE_CLIENT_ID=
GANZ_YOUTUBE_CLIENT_SECRET=
GANZ_YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback
# Waar een geüploade video op komt te staan: private, unlisted of public. Standaard privé,
# want een verkeerde upload die meteen openbaar is, is niet meer terug te nemen.
GANZ_YOUTUBE_UPLOAD_PRIVACY=private
# De map waar je video's staan. Leeg = uploaden staat uit. Alleen wat hierin staat kan
# geüpload worden; zonder die grens kan een skill elk bestand van de computer versturen.
GANZ_YOUTUBE_VIDEO_DIR=

# Achtergrondsynchronisatie. Niet te laag zetten: providers hebben rate limits.
GANZ_SCHEDULER_ENABLED=true
GANZ_FINANCE_SYNC_MINUTES=15
GANZ_SOCIAL_SYNC_MINUTES=30

# Ouder dan dit en het dashboard noemt de gegevens verouderd.
GANZ_STALE_AFTER_MINUTES=60

# Voorbeelddata. Uitsluitend tijdens het bouwen; in productie moet dit uit staan.
GANZ_ALLOW_SEED_DATA=false

# --- Sleutels van providers ---
# Deze vul je NIET hier in. Ze horen bij een account of kanaal en gaan versleuteld de
# database in via het scherm "Account koppelen" of "Kanaal koppelen".
# Je maakt ze zelf aan bij de betreffende partij; Ganz kan dat niet voor je doen:
#   YouTube    Google Cloud Console → YouTube Data API v3 → API-sleutel
#   Instagram  Meta for Developers → Instagram Graph API → toegangstoken
#   TikTok     TikTok for Developers → Display API → OAuth-token
# Wisselkoersen komen van de ECB via frankfurter.app en crypto-koersen van CoinGecko;
# daar is geen sleutel voor nodig.

# --- Stemherkenning ---------------------------------------------------------
# Het model dat van een opname een vingerafdruk maakt. Wissel je hiervan, dan moet iedereen
# zich opnieuw laten inschrijven.
GANZ_VOICE_MODEL=speechbrain/spkrec-ecapa-voxceleb
# GANZ_VOICE_MODEL_CACHE_DIR=

# Vanaf hoeveel gelijkenis (0 tot 1) een stem als herkend geldt. Hoger is strenger.
GANZ_VOICE_MATCH_THRESHOLD=0.25
# Onder deze grens is de herkenning te zwak voor gevoelige acties.
GANZ_VOICE_STRONG_THRESHOLD=0.45

GANZ_VOICE_MIN_SECONDS=1.0
GANZ_VOICE_MAX_SECONDS=30.0

# Zolang er nog geen stem is ingeschreven staat inschrijven open, anders kom je er nooit in.
# Zet dit op false zodra iedereen die toegang moet hebben is ingeschreven.
GANZ_VOICE_ENROLLMENT_OPEN_WHEN_EMPTY=true

# --- Skills -----------------------------------------------------------------
# Het model dat opdrachten en skills op betekenis vergelijkt. Draait lokaal; er gaat nooit
# iets naar een externe dienst om te matchen. Zonder dit model matcht Ganz op woorden.
GANZ_SKILL_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# GANZ_SKILL_MODEL_CACHE_DIR=

# Vanaf hoeveel gelijkenis een skill bij een opdracht hoort. Let op: matchen op woorden en
# matchen op betekenis tellen niet hetzelfde — zie docs/skills.md.
GANZ_SKILL_MATCH_THRESHOLD=0.45
