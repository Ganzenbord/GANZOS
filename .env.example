# Ganz — instellingen.
# Kopieer dit bestand naar backend/.env en vul je eigen waarden in.
# Dit bestand mag in de repository staan; backend/.env nooit.

# development, test of production
GANZ_ENVIRONMENT=development

# Database. Voor PostgreSQL:
GANZ_DATABASE_URL=postgresql+asyncpg://ganz:ganz@localhost:5432/ganz

# Ondertekent de inlogtokens. Maak er een met:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GANZ_SECRET_KEY=

# Versleutelt de provider-tokens in de database. Maak er een met:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Let op: wissel je deze sleutel, dan moet je alle koppelingen opnieuw maken.
GANZ_ENCRYPTION_KEY=

# Hoe lang een sessie geldig is, en hoe kort een tweede bevestiging meegaat.
GANZ_ACCESS_TOKEN_MINUTES=720
GANZ_CONFIRMATION_TOKEN_MINUTES=5

# Waar de frontend vandaan mag komen (kommagescheiden).
GANZ_CORS_ORIGINS=http://localhost:5173

# Achtergrondsynchronisatie. Niet te laag zetten: providers hebben rate limits.
GANZ_SCHEDULER_ENABLED=true
GANZ_FINANCE_SYNC_MINUTES=15
GANZ_SOCIAL_SYNC_MINUTES=30

# Ouder dan dit en het dashboard noemt de gegevens verouderd.
GANZ_STALE_AFTER_MINUTES=60

# Voorbeelddata. Uitsluitend tijdens het bouwen; in productie moet dit uit staan.
GANZ_ALLOW_SEED_DATA=false

# --- Sleutels van providers ---
# Deze vul je NIET hier in. Ze horen bij een account of kanaal en gaan versleuteld de
# database in via het scherm "Account koppelen" of "Kanaal koppelen".
# Je maakt ze zelf aan bij de betreffende partij; Ganz kan dat niet voor je doen:
#   YouTube    Google Cloud Console → YouTube Data API v3 → API-sleutel
#   Instagram  Meta for Developers → Instagram Graph API → toegangstoken
#   TikTok     TikTok for Developers → Display API → OAuth-token
# Wisselkoersen komen van de ECB via frankfurter.app en crypto-koersen van CoinGecko;
# daar is geen sleutel voor nodig.
