{
  "name": "ganz",
  "version": "2.0.0",
  "description": "Ganz — persoonlijk AI Command Center",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "app": "electron .",
    "app:dev": "GANZ_DEV=1 electron .",
    "build:frontend": "npm --prefix frontend run build",
    "app:build": "npm run build:frontend && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "nl.ganzenbord.ganz",
    "productName": "Ganz",
    "files": ["electron/**", "frontend/dist/**"],
    "mac": { "category": "public.app-category.productivity" },
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
