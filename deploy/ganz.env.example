# Hoort te staan in /etc/ganz/ganz.env, met rechten 0600 en eigendom van root.
# Dit bestand is het voorbeeld; de echte staat nergens in de repository.
#
#   sudo install -d -m 0700 /etc/ganz
#   sudo install -m 0600 deploy/ganz.env.example /etc/ganz/ganz.env
#   sudo nano /etc/ganz/ganz.env

# --- Waar Ganz te bereiken is -----------------------------------------------
# De naam die Tailscale aan deze machine geeft. Zie `tailscale status`.
GANZ_HOSTNAME=ganz.jouw-tailnet.ts.net
# Het adres van de tailscale0-kaart. Zie `tailscale ip -4`. Met opzet niet 0.0.0.0:
# dan luistert Ganz ook op je gewone netwerkkaart.
GANZ_BIND_ADDRESS=100.x.y.z
# Waar het certificaat van `tailscale cert` staat (ganz.crt en ganz.key).
GANZ_CERT_DIR=/etc/ganz/certs

# --- Sleutels ----------------------------------------------------------------
# Elk een eigen waarde, en nooit die uit de voorbeelden. Maken:
#   openssl rand -hex 32
POSTGRES_PASSWORD=
GANZ_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Let op: deze sleutel apart van je databaseback-up bewaren. Samen in één back-up betekent
# dat één gestolen back-up al je gekoppelde accounts openlegt; helemaal niet bewaard
# betekent dat een teruggezette back-up onbruikbaar is.
GANZ_ENCRYPTION_KEY=

# --- YouTube ------------------------------------------------------------------
GANZ_YOUTUBE_CLIENT_ID=
GANZ_YOUTUBE_CLIENT_SECRET=
# Lettergelijk hetzelfde als in de Google Cloud-console.
GANZ_YOUTUBE_REDIRECT_URI=https://ganz.jouw-tailnet.ts.net/api/youtube/oauth/callback

# --- Video's ------------------------------------------------------------------
# De map op de host waar je video's staan. Ganz krijgt hem read-only te zien.
GANZ_VIDEO_DIR=/srv/ganz/videos

# --- CORS ---------------------------------------------------------------------
# Leeg laten. Het scherm komt van dezelfde naam als de API, dus er is geen andere
# herkomst om toe te staan. Staat hier iets, dan mag díe site bij je API.
GANZ_CORS_ORIGINS=
